datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Audit {
  id            String    @id @default(uuid()) @postgresql.Uuid
  type          String
  tableName     String    @default("")
  recordId      String    @default("")
  changeSubType String?
  changes       Json?
  createdBy     User?     @relation("Audit_createdBy", fields: [createdById], references: [id])
  createdById   String?   @map("createdBy") @postgresql.Uuid
  createdAt     DateTime? @default(now())

  @@index([createdById])
}

model ManagedAccount {
  id                         String               @id @default(uuid()) @postgresql.Uuid
  name                       String               @default("")
  description                String               @default("")
  managedAccountLinks        ManagedAccountLink[] @relation("ManagedAccountLink_managedAccount")
  user                       User?                @relation("ManagedAccount_user", fields: [userId], references: [id])
  userId                     String?              @map("user") @postgresql.Uuid
  from_UploadProject_account UploadProject[]      @relation("UploadProject_account")

  @@index([userId])
}

model ManagedAccountLink {
  id               String          @id @default(uuid()) @postgresql.Uuid
  accountName      String          @default("")
  managedAccount   ManagedAccount? @relation("ManagedAccountLink_managedAccount", fields: [managedAccountId], references: [id])
  managedAccountId String?         @map("managedAccount") @postgresql.Uuid
  tokenFor         String
  accessToken      String          @default("")
  refreshToken     String          @default("")
  expiryDate       DateTime
  scopes           String          @default("")

  @@index([managedAccountId])
}

model Upload {
  id           String         @id @default(uuid()) @postgresql.Uuid
  uploadTo     String
  uploadStatus String?        @default("PENDING_RELEASE")
  project      UploadProject? @relation("Upload_project", fields: [projectId], references: [id])
  projectId    String?        @map("project") @postgresql.Uuid
  scheduledFor DateTime?
  createdAt    DateTime?      @default(now())
  updatedAt    DateTime?

  @@index([projectId])
}

model UploadLocation {
  id                                      String                      @id @default(uuid()) @postgresql.Uuid
  type                                    String
  project                                 UploadProject?              @relation("UploadLocation_project", fields: [projectId], references: [id])
  projectId                               String?                     @unique @map("project") @postgresql.Uuid
  s3Link                                  UploadLocationS3?           @relation("UploadLocation_s3Link", fields: [s3LinkId], references: [id])
  s3LinkId                                String?                     @map("s3Link") @postgresql.Uuid
  localLink                               UploadLocationLocal?        @relation("UploadLocation_localLink", fields: [localLinkId], references: [id])
  localLinkId                             String?                     @map("localLink") @postgresql.Uuid
  googleDrive                             UploadLocationGoogleDrive?  @relation("UploadLocation_googleDrive", fields: [googleDriveId], references: [id])
  googleDriveId                           String?                     @map("googleDrive") @postgresql.Uuid
  from_UploadLocationGoogleDrive_location UploadLocationGoogleDrive[] @relation("UploadLocationGoogleDrive_location")
  from_UploadLocationLocal_location       UploadLocationLocal[]       @relation("UploadLocationLocal_location")
  from_UploadLocationS3_location          UploadLocationS3[]          @relation("UploadLocationS3_location")

  @@index([s3LinkId])
  @@index([localLinkId])
  @@index([googleDriveId])
}

model UploadLocationGoogleDrive {
  id                              String           @id @default(uuid()) @postgresql.Uuid
  location                        UploadLocation?  @relation("UploadLocationGoogleDrive_location", fields: [locationId], references: [id])
  locationId                      String?          @map("location") @postgresql.Uuid
  driveId                         String           @default("")
  name                            String           @default("")
  from_UploadLocation_googleDrive UploadLocation[] @relation("UploadLocation_googleDrive")

  @@index([locationId])
}

model UploadLocationLocal {
  id                            String           @id @default(uuid()) @postgresql.Uuid
  location                      UploadLocation?  @relation("UploadLocationLocal_location", fields: [locationId], references: [id])
  locationId                    String?          @map("location") @postgresql.Uuid
  path                          String           @default("")
  from_UploadLocation_localLink UploadLocation[] @relation("UploadLocation_localLink")

  @@index([locationId])
