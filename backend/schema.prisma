// This file is automatically generated by Keystone, do not modify it manually.
// Modify your Keystone config when you want to change this.

datasource postgresql {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "postgresql"
}

generator client {
  provider = "prisma-client-js"
}

model Upload {
  id           String         @id @default(uuid()) @postgresql.Uuid
  uploadTo     String
  uploadStatus String?        @default("PENDING_RELEASE")
  project      UploadProject? @relation("Upload_project", fields: [projectId], references: [id])
  projectId    String?        @map("project") @postgresql.Uuid
  createdAt    DateTime?      @default(now())
  updatedAt    DateTime?

  @@index([projectId])
}

model UploadLocation {
  id                                      String                      @id @default(uuid()) @postgresql.Uuid
  type                                    String
  project                                 UploadProject?              @relation("UploadLocation_project", fields: [projectId], references: [id])
  projectId                               String?                     @unique @map("project") @postgresql.Uuid
  from_UploadLocationGoogleDrive_location UploadLocationGoogleDrive[] @relation("UploadLocationGoogleDrive_location")
  from_UploadLocationLocal_location       UploadLocationLocal[]       @relation("UploadLocationLocal_location")
  from_UploadLocationS3_location          UploadLocationS3[]          @relation("UploadLocationS3_location")
}

model UploadLocationGoogleDrive {
  id         String          @id @default(uuid()) @postgresql.Uuid
  location   UploadLocation? @relation("UploadLocationGoogleDrive_location", fields: [locationId], references: [id])
  locationId String?         @map("location") @postgresql.Uuid
  driveId    String          @default("")
  name       String          @default("")

  @@index([locationId])
}

model UploadLocationLocal {
  id         String          @id @default(uuid()) @postgresql.Uuid
  location   UploadLocation? @relation("UploadLocationLocal_location", fields: [locationId], references: [id])
  locationId String?         @map("location") @postgresql.Uuid
  path       String          @default("")

  @@index([locationId])
}

model UploadLocationS3 {
  id         String          @id @default(uuid()) @postgresql.Uuid
  location   UploadLocation? @relation("UploadLocationS3_location", fields: [locationId], references: [id])
  locationId String?         @map("location") @postgresql.Uuid
  bucket     String          @default("")
  key        String          @default("")

  @@index([locationId])
}

model UploadProject {
  id             String          @id @default(uuid()) @postgresql.Uuid
  projectName    String          @default("")
  description    String          @default("")
  user           User?           @relation("UploadProject_user", fields: [userId], references: [id])
  userId         String?         @map("user") @postgresql.Uuid
  status         String          @default("CREATED")
  uploadLocation UploadLocation? @relation("UploadLocation_project")
  uploadsTo      Upload[]        @relation("Upload_project")
  createdAt      DateTime?       @default(now())
  updatedAt      DateTime?       @default(now()) @updatedAt
  deletedAt      DateTime?

  @@index([userId])
}

model User {
  id        String          @id @default(uuid()) @postgresql.Uuid
  name      String          @default("")
  email     String          @unique @default("")
  password  String
  projects  UploadProject[] @relation("UploadProject_user")
  isAdmin   Boolean         @default(false)
  tokens    UserToken[]     @relation("UserToken_user")
  createdAt DateTime?       @default(now())
}

model UserToken {
  id           String   @id @default(uuid()) @postgresql.Uuid
  user         User?    @relation("UserToken_user", fields: [userId], references: [id])
  userId       String?  @map("user") @postgresql.Uuid
  tokenFor     String
  accessToken  String   @default("")
  refreshToken String   @default("")
  expiryDate   DateTime
  scopes       String   @default("")

  @@index([userId])
}

model Video {
  id          String    @id @default(uuid()) @postgresql.Uuid
  title       String    @default("")
  description String    @default("")
  filePath    String    @default("")
  status      String?   @default("pending")
  uploadedAt  DateTime?
}
